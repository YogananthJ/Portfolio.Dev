<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Yogananth — Developer / Portfolio 2026</title>

<meta name="description" content="Yogananth — future-focused developer building web apps, AI experiments, and automation." />
<meta property="og:title" content="Yogananth — Developer / Portfolio" />
<meta property="og:description" content="Future-focused developer building web apps, AI experiments, and automation." />
<meta property="og:type" content="website" />
<meta name="theme-color" content="#f3f0e8" />

<link rel="icon" type="image/png" sizes="32x32" href="assets/favicon.png" />
<link rel="icon" type="image/png" sizes="16x16" href="assets/favicon.png" />
<link rel="apple-touch-icon" href="assets/favicon.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>
/* ---------- Tokens ---------- */
:root{
  --paper:#f3f0e8;
  --paper-2:#efe7d9;
  --ink:#090909;
  --ink-2:#1a1a1a;
  --red:#F20D26;
  --muted:#6b6257;
  --line:rgba(17,17,17,.09);
  --grid:rgba(0,0,0,.08);

  --font-display:"Archivo Black", Impact, "Arial Black", sans-serif;
  --font-body:"Inter", Arial, Helvetica, sans-serif;

  --maxw:1180px;
  --pad:clamp(16px, 4vw, 40px);
  --radius:2px;
}

/* ---------- Reset ---------- */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth; -webkit-text-size-adjust:100%}
body{
  margin:0;
  font-family:var(--font-body);
  color:var(--ink);
  background-color:var(--paper);
  line-height:1.55;
  overflow-x:hidden;
  background-image:
    linear-gradient(to right, var(--grid) 1px, transparent 1px),
    linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
  background-size:24px 24px;
  background-position:0 0;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%; display:block}
a{color:inherit; text-decoration:none}
button{font:inherit; cursor:pointer; background:none; border:0; color:inherit}

/* Three.js Canvas */
#webgl-container {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  z-index: -1; pointer-events: none; opacity: 0.6;
}

/* Scroll Progress */
#scroll-progress {
  position: fixed; top: 0; left: 0; width: 100%; height: 3px;
  background: var(--red); transform-origin: 0 50%; transform: scaleX(0);
  z-index: 100;
}

/* Fallback visibility - essential content is ALWAYS visible */
.essential-content { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.001ms !important; transition-duration:.001ms !important;}
  #webgl-container { display: none; }
  /* If GSAP is disabled, we still want everything visible */
  .gsap-hidden { opacity: 1 !important; transform: none !important; }
}

/* ---------- Layout ---------- */
.container{max-width:var(--maxw); margin:0 auto; padding:0 var(--pad)}
.section{padding:clamp(56px, 9vw, 120px) 0; position:relative}

/* ---------- Header ---------- */
.site-header{
  position:sticky; top:0; z-index:50;
  background:rgba(243,240,232,.88);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  border-bottom:1px solid var(--line);
}
.nav{
  display:flex; align-items:center; justify-content:space-between;
  gap:16px; padding:14px var(--pad); max-width:var(--maxw); margin:0 auto;
  position: relative;
}
.brand{
  font-family:var(--font-display); font-size:18px; letter-spacing:.02em; color:var(--ink);
}
.brand::after{content:""; display:inline-block; width:8px; height:8px; background:var(--red); margin-left:6px; vertical-align:middle}

.nav__list{display:flex; gap:4px; list-style:none; margin:0; padding:0}
.nav__link{
  padding:8px 14px; border-radius:var(--radius); font-weight:600; font-size:14px; color:var(--ink);
  border:1px solid transparent; transition:background .15s, border-color .15s, color .15s;
}
.nav__link:hover{background:var(--paper-2)}
.nav__link.active-link{background:var(--ink); color:var(--paper); border-color:var(--ink)}
.nav__link:focus-visible{outline:2px solid var(--red); outline-offset:2px}

.nav__toggle{
  display:none; width:44px; height:44px; align-items:center; justify-content:center;
  border:1px solid var(--ink); border-radius:var(--radius);
}
.nav__toggle:focus-visible{outline:2px solid var(--red); outline-offset:2px}
.nav__toggle svg{width:22px; height:22px; stroke:var(--ink); fill:none; stroke-width:2.2}

@media (max-width:820px){
  .nav__list{
    position:fixed; top: 60px; left: 0; right: 0; /* Fixed relative to header */
    flex-direction:column; gap:0;
    background:var(--paper); border-bottom:1px solid var(--line);
    padding:8px var(--pad) 16px;
    transform:translateY(-12px); opacity:0; pointer-events:none; visibility:hidden;
    transition:opacity .18s ease, transform .18s ease, visibility .18s;
    box-shadow:0 12px 24px rgba(0,0,0,.08);
    z-index: 60;
  }
  .nav__list.is-open{transform:translateY(0); opacity:1; pointer-events:auto; visibility:visible;}
  .nav__list .nav__link{display:block; padding:14px 8px; border-radius:0; border-bottom:1px solid var(--line); font-size:16px;}
  .nav__toggle{display:inline-flex}
  body.menu-open{overflow:hidden}
}

/* ---------- Buttons ---------- */
.btn{
  display:inline-flex; align-items:center; gap:10px; padding:12px 20px;
  font-weight:700; font-size:14px; letter-spacing:.02em;
  border:2px solid var(--ink); border-radius:var(--radius);
  background:var(--ink); color:var(--paper);
  transition:transform .15s, background .15s, color .15s;
  will-change: transform;
  cursor: pointer;
}
.btn:hover{background:var(--red); border-color:var(--red)}
.btn:focus-visible{outline:2px solid var(--red); outline-offset:3px}
.btn svg{width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2.4}

/* ============================================================
   HERO COLLAGE (Responsive Sizing)
   ============================================================ */
.hero-collage {
  position: relative;
  width: 100%;
  /* Natural height, no fixed min-height */
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  padding-top: 40px;
  padding-bottom: 80px;
}

.hero-meta-top {
  width: 100%; max-width: var(--maxw); padding: 0 var(--pad);
  display: flex; justify-content: space-between; align-items: center;
  font-size: 11px; font-weight: 700; letter-spacing: .18em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 20px; z-index: 5;
}

.collage-stage {
  position: relative;
  width: 100%;
  max-width: 1200px;
  /* Use aspect-ratio to create a natural stage height that scales */
  aspect-ratio: 16 / 9;
  min-height: 400px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20px;
}

.collage-paper {
  position: absolute;
  top: 0; left: -50px; right: -50px; bottom: 0;
  background: var(--ink);
  z-index: 1;
  clip-path: polygon(
    0% 15%, 5% 8%, 12% 18%, 20% 5%, 28% 22%, 35% 10%, 42% 25%, 48% 8%, 
    55% 20%, 62% 5%, 68% 18%, 75% 8%, 82% 22%, 88% 10%, 95% 18%, 100% 12%, 
    100% 88%, 95% 95%, 88% 82%, 80% 98%, 72% 85%, 65% 92%, 58% 80%, 50% 95%, 
    42% 82%, 35% 98%, 28% 85%, 20% 95%, 12% 82%, 5% 95%, 0% 88%
  );
}

.collage-type {
  position: absolute;
  top: 40%; left: 50%;
  transform: translate(-50%, -50%);
  width: 100%; /* Controlled */
  text-align: center;
  font-family: var(--font-display);
  font-size: clamp(100px, 22vw, 280px); 
  line-height: 0.75;
  letter-spacing: -0.03em;
  color: #f8f7f3;
  text-transform: uppercase;
  z-index: 2; pointer-events: none;
  white-space: nowrap;
  /* Prevent horizontal overflow */
  overflow: visible;
}

/* The Transparent PNG Silhouette */
.collage-portrait {
  position: absolute;
  z-index: 3;
  width: clamp(280px, 50vw, 480px);
  height: clamp(400px, 70vh, 600px);
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  /* No background, no border, no box-shadow */
}

.collage-portrait img {
  width: 100%; height: 100%;
  object-fit: contain; /* Keeps transparent PNG proportions */
  object-position: bottom;
  /* Thick red outline following the silhouette using layered drop-shadow */
  filter: 
    drop-shadow( 4px  0 0 var(--red))
    drop-shadow(-4px  0 0 var(--red))
    drop-shadow( 0  4px 0 var(--red))
    drop-shadow( 0 -4px 0 var(--red))
    drop-shadow( 3px  3px 0 var(--red))
    drop-shadow(-3px -3px 0 var(--red))
    drop-shadow( 3px -3px 0 var(--red))
    drop-shadow(-3px  3px 0 var(--red));
}

.collage-decor {
  position: absolute; z-index: 5; color: #f8f7f3; pointer-events: none;
}
.collage-decor--1 { right: 15%; top: 45%; width: 60px; }
.collage-decor--2 { right: 8%; top: 55%; width: 40px; }

.hero-intro-bottom {
  text-align: center; max-width: 650px; margin: 40px auto 0;
  z-index: 5; position: relative;
  background: var(--paper); padding: 20px;
  border: 2px solid var(--ink); box-shadow: 6px 6px 0 var(--ink);
}
.hero-intro-bottom p { margin: 0 0 24px; font-size: clamp(15px, 1.8vw, 18px); color: #2b2621; line-height: 1.6; }
.hero__socials { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
.social-pill {
  display:inline-flex; align-items:center; gap:8px; padding:10px 18px;
  border:1px solid var(--ink); border-radius:999px; font-size:14px; font-weight:600;
  transition:background .15s, color .15s; background: var(--paper);
}
.social-pill:hover{background:var(--ink); color:var(--paper)}
.social-pill:focus-visible{outline:2px solid var(--red); outline-offset:2px}
.social-pill svg{width:16px; height:16px; fill:currentColor}

@media (max-width: 900px) {
  .collage-stage { aspect-ratio: 4/3; }
  .collage-type { font-size: clamp(80px, 20vw, 160px); }
}
@media (max-width: 600px) {
  .collage-stage { aspect-ratio: 1/1; min-height: 300px; margin-top: 10px; }
  .collage-type { font-size: clamp(60px, 18vw, 120px); top: 45%; }
  .collage-portrait { width: 80%; height: 80%; }
  .collage-decor { display: none; }
  .hero-intro-bottom { margin-top: 20px; }
}

/* ---------- Section heading ---------- */
.sec-head{
  display:flex; align-items:flex-end; justify-content:space-between;
  gap:16px; margin-bottom:clamp(24px, 5vw, 48px);
  border-bottom:2px solid var(--ink); padding-bottom:14px; flex-wrap:wrap;
}
.sec-head h2{
  font-family:var(--font-display); font-size:clamp(32px, 6vw, 64px);
  line-height:.92; margin:0; letter-spacing:-.01em; text-transform:uppercase;
}
.sec-head .count{ font-size:12px; font-weight:700; letter-spacing:.2em; color:var(--red); text-transform:uppercase; }

/* ---------- Torn divider ---------- */
.torn{position:relative; height:44px; margin-top:-1px; pointer-events:none}
.torn svg{position:absolute; inset:0; width:100%; height:100%; display:block; overflow: visible;}
.torn svg path{ fill:var(--ink); stroke:var(--ink); stroke-width:2; vector-effect: non-scaling-stroke; }

/* ---------- About ---------- */
.about__grid{ display:grid; grid-template-columns:1.2fr .9fr; gap:clamp(24px, 5vw, 56px); align-items:start; }
.about__quote{ font-family:var(--font-display); font-size:clamp(24px, 3.6vw, 40px); line-height:1.04; margin:0 0 24px; text-transform:uppercase; }
.about__quote .accent{color:var(--red)}
.about__body p{color:#2b2621; margin:0 0 16px; max-width:52ch}
.about__body p:first-child::first-letter{ font-family:var(--font-display); font-size:3.2em; float:left; line-height:.85; padding:6px 10px 0 0; color:var(--red); }

.facts{list-style:none; margin:0; padding:0; border-top:1px solid var(--line)}
.facts li{ display:grid; grid-template-columns:110px 1fr; gap:14px; padding:14px 0; border-bottom:1px solid var(--line); font-size:14px; }
.facts li strong{ font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--red); font-weight:800; padding-top:2px; }

@media (max-width:780px){ .about__grid{grid-template-columns:1fr} }

/* ============================================================
   SKILLS SHOWCASE
   ============================================================ */
.ink-panel{background:var(--ink); color:var(--paper); position:relative}
.ink-panel .sec-head{border-bottom-color:rgba(255,255,255,.18)}
.ink-panel .sec-head .count{color:#ff5a6e}

.skills-table { display: flex; flex-direction: column; border-top: 2px solid var(--paper); }
.skill-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 2px solid rgba(255,255,255,0.15); padding: 24px 0; transition: background 0.3s, padding 0.3s; }
.skill-row:hover { background: rgba(255,255,255,0.03); padding-left: 16px; }
.skill-category { font-family: var(--font-display); font-size: clamp(18px, 2.2vw, 24px); text-transform: uppercase; color: #ff5a6e; padding-top: 4px; }
.skill-items { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; }
.skill-item { font-family: var(--font-body); font-size: clamp(16px, 2vw, 20px); font-weight: 600; color: var(--paper); position: relative; }
.skill-item::after { content: '/'; position: absolute; right: -16px; color: rgba(255,255,255,0.2); font-weight: 400; }
.skill-item:last-child::after { display: none; }

@media (max-width: 780px) {
  .skill-row { grid-template-columns: 1fr; gap: 16px; }
  .skill-category { border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 8px; }
}

/* ============================================================
   PROJECTS SHOWCASE
   ============================================================ */
.projects-editorial {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: clamp(24px, 4vw, 48px);
  margin-top: 40px;
}
.project-item {
  position: relative; display: flex; flex-direction: column;
  min-width: 0; /* Fixes flex/grid overflow */
}
/* Asymmetric layout */
.project-item:nth-child(4n+1), .project-item:nth-child(4n+4) { grid-column: span 7; }
.project-item:nth-child(4n+2), .project-item:nth-child(4n+3) { grid-column: span 5; }

@media (max-width: 900px) {
  .project-item { grid-column: span 12 !important; }
}

.project-media {
  position: relative; aspect-ratio: 16/10;
  border: 2px solid var(--ink); background: var(--paper-2); overflow: hidden;
  transition: border-color 0.3s, box-shadow 0.3s;
  box-shadow: 8px 8px 0 var(--ink);
}
.project-item:hover .project-media { border-color: var(--red); box-shadow: 12px 12px 0 var(--red); }
.project-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
.project-item:hover .project-media img { transform: scale(1.05); }

.project-content { padding: 24px 0 0; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.project-title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
.project-title {
  font-family: var(--font-display); font-size: clamp(24px, 3.5vw, 42px);
  line-height: 0.95; margin: 0; text-transform: uppercase;
  overflow-wrap: anywhere; /* Prevents overflow */
}
.project-link {
  flex: 0 0 auto; width: 48px; height: 48px;
  display: inline-flex; align-items: center; justify-content: center;
  border: 2px solid var(--ink); border-radius: var(--radius);
  transition: background 0.15s, color 0.15s, transform 0.15s;
}
.project-item:hover .project-link { background: var(--red); color: white; border-color: var(--red); transform: translate(-2px, -2px); }
.project-link svg { width: 22px; height: 22px; fill: currentColor; }

.project-desc { font-size: 15px; color: #2b2621; line-height: 1.6; max-width: 60ch; overflow-wrap: anywhere; }
.project-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.project-tag {
  font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
  padding: 6px 10px; border: 1px solid var(--ink); border-radius: var(--radius); color: var(--ink);
  transition: background 0.2s, color 0.2s;
}
.project-item:hover .project-tag { background: var(--ink); color: var(--paper); }

/* ---------- Contact ---------- */
.contact__wrap{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(24px, 5vw, 64px); align-items:start; }
.contact__lede h2{ font-family:var(--font-display); font-size:clamp(36px, 6vw, 72px); line-height:.9; margin:0 0 18px; text-transform:uppercase; }
.contact__lede h2 span{color:var(--red)}
.contact__lede p{max-width:44ch; color:#2b2621; margin:0 0 20px}
.contact__direct{display:flex; flex-direction:column; gap:8px; font-size:14px}
.contact__direct a{border-bottom:1px solid var(--red); padding-bottom:2px; width:max-content; overflow-wrap: anywhere;}
.contact__direct a:hover{color:var(--red)}

form.contact__form{display:flex; flex-direction:column; gap:14px; min-width: 0;}
.field{display:flex; flex-direction:column; gap:6px; min-width: 0;}
.field label{ font-size:11px; letter-spacing:.18em; text-transform:uppercase; font-weight:800; color:var(--ink); }
.field input, .field textarea{
  font:inherit; font-size:15px; padding:14px 16px;
  background:var(--paper); border:2px solid var(--ink); border-radius:var(--radius);
  color:var(--ink); width: 100%; max-width: 100%; /* Prevent overflow */
  transition:border-color .15s, box-shadow .15s;
}
.field input:focus, .field textarea:focus{ outline:none; border-color:var(--red); box-shadow:4px 4px 0 var(--red); }
.field textarea{min-height:140px; resize:vertical}
.form-note{ font-size:12px; color:var(--muted); padding:10px 12px; border-left:3px solid var(--red); background:rgba(215,38,61,.06); }
.form-note[hidden]{display:none}
.form-status{font-size:13px; margin:0; min-height:1.2em}
.form-status[data-state="error"]{color:var(--red)}
.form-status[data-state="ok"]{color:#1c7f3a}

@media (max-width:780px){ .contact__wrap{grid-template-columns:1fr} }

/* ---------- Footer ---------- */
.site-footer{ background:var(--ink); color:var(--paper); padding:40px 0 32px; margin-top:0; overflow: hidden; }
.footer__row{ display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; border-bottom:1px solid rgba(255,255,255,.15); padding-bottom:20px; margin-bottom:20px; position: relative; z-index: 2; }
.footer__brand{ font-family:var(--font-display); font-size:clamp(28px, 5vw, 48px); line-height:.9; margin:0; text-transform:uppercase; }
.footer__socials{display:flex; gap:10px; flex-wrap:wrap}
.footer__socials a{ display:inline-flex; align-items:center; gap:8px; padding:8px 14px; border:1px solid rgba(255,255,255,.35); border-radius:999px; font-size:13px; font-weight:600; transition:background .15s, color .15s; }
.footer__socials a:hover{background:var(--paper); color:var(--ink)}
.footer__socials a:focus-visible{outline:2px solid #ff5a6e; outline-offset:2px}
.footer__socials svg{width:15px; height:15px; fill:currentColor}
.footer__meta{ display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; font-size:12px; color:rgba(243,240,232,.65); position: relative; z-index: 2; }
</style>
</head>
<body>

<div id="scroll-progress"></div>
<div id="webgl-container"></div>

<a class="skip" href="#main" style="position:absolute;left:-9999px;top:auto" onfocus="this.style.cssText='position:fixed;left:12px;top:12px;background:#111;color:#fff;padding:10px 14px;z-index:999;border-radius:2px'">Skip to content</a>

<header class="site-header">
  <nav class="nav" aria-label="Main navigation">
    <a class="brand" href="#home">YOGANANTH</a>
    <ul class="nav__list" id="nav-list">
      <li><a class="nav__link active-link" href="#home">Home</a></li>
      <li><a class="nav__link" href="#about">About</a></li>
      <li><a class="nav__link" href="#skills">Skills</a></li>
      <li><a class="nav__link" href="#projects">Projects</a></li>
      <li><a class="nav__link" href="#contact">Contact</a></li>
    </ul>
    <button class="nav__toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-list">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </nav>
</header>

<main id="main">

  <!-- ========== HERO COLLAGE ========== -->
  <section class="section hero" id="home" style="padding-top:0; padding-bottom:40px;">
    <div class="hero-collage">
      
      <div class="hero-meta-top essential-content">
        <span>Developer / AI · Automation</span>
        <span>2026</span>
      </div>

      <div class="collage-stage">
        <div class="collage-paper essential-content" aria-hidden="true"></div>
        <div class="collage-type essential-content" id="hero-type" aria-hidden="true">YOGANANTH</div>

        <svg class="collage-decor collage-decor--1 essential-content" viewBox="0 0 100 100" aria-hidden="true">
          <path fill="currentColor" d="M50 0 C55 30 70 45 100 50 C70 55 55 70 50 100 C45 70 30 55 0 50 C30 45 45 30 50 0 Z"/>
        </svg>
        <svg class="collage-decor collage-decor--2 essential-content" viewBox="0 0 100 100" aria-hidden="true">
           <circle cx="50" cy="50" r="40" fill="none" stroke="currentColor" stroke-width="6"/>
        </svg>

        <div class="collage-portrait essential-content">
          <img id="hero-portrait" src="assets/favicon.png" alt="Portrait of Yogananth" fetchpriority="high" onerror="this.style.display='none'; this.parentElement.innerHTML='<p style=\'color:white;text-align:center;padding:20px;\'>Image not found</p>';" />
        </div>
      </div>

