<!-- Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
(function () {
  "use strict";

  /* ============================================================
     CONFIG & SAFETY WRAPPER
     ============================================================ */
  var CONTACT_EMAIL = ""; 

  /* ============================================================
     VANILLA JS (Navigation & Form)
     ============================================================ */
  var yearEl = document.getElementById("year");
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  var toggle = document.getElementById("nav-toggle");
  var list = document.getElementById("nav-list");
  var body = document.body;

  function setMenu(open) {
    if (!toggle || !list) return;
    list.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    body.classList.toggle("menu-open", open);
  }

  if (toggle && list) {
    toggle.addEventListener("click", function () { setMenu(!list.classList.contains("is-open")); });
    list.querySelectorAll(".nav__link").forEach(function (link) { link.addEventListener("click", function () { setMenu(false); }); });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && list.classList.contains("is-open")) { setMenu(false); toggle.focus(); }
    });
    window.addEventListener("resize", function () {
      if (window.innerWidth > 820 && list.classList.contains("is-open")) { setMenu(false); }
    });
  }

  // Scroll Observer for Active Nav
  var sections = document.querySelectorAll("main section[id]");
  var navLinks = document.querySelectorAll(".nav__menu a, #nav-list .nav__link");
  var byId = {};
  navLinks.forEach(function (a) {
    var href = a.getAttribute("href") || "";
    if (href.charAt(0) === "#") byId[href.slice(1)] = a;
  });

  if ("IntersectionObserver" in window && sections.length) {
    var visible = {};
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) { visible[entry.target.id] = entry.isIntersecting ? entry.intersectionRatio : 0; });
      var bestId = null, bestRatio = 0;
      Object.keys(visible).forEach(function (id) {
        if (visible[id] > bestRatio) { bestRatio = visible[id]; bestId = id; }
      });
      navLinks.forEach(function (a) { a.classList.remove("active-link"); });
      if (bestId && byId[bestId]) byId[bestId].classList.add("active-link");
    }, { rootMargin: "-45% 0px -45% 0px", threshold: [0, 0.25, 0.5, 0.75, 1] });
    sections.forEach(function (s) { io.observe(s); });
  }

  // Contact Form
  var form = document.getElementById("contactForm");
  var status = document.getElementById("formStatus");
  var note = document.getElementById("formNote");

  if (note) {
    if (CONTACT_EMAIL && CONTACT_EMAIL.indexOf("@") > 0) { note.hidden = true; }
    else { note.hidden = true; note.dataset.pending = "1"; }
  }

  function setStatus(msg, state) {
    if (!status) return;
    status.textContent = msg || "";
    if (state) status.setAttribute("data-state", state);
    else status.removeAttribute("data-state");
  }

  if (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var name = (document.getElementById("name") || {}).value || "";
      var email = (document.getElementById("email") || {}).value || "";
      var message = (document.getElementById("message") || {}).value || "";
      name = name.trim(); email = email.trim(); message = message.trim();

      if (!name || !email || !message) { setStatus("Please fill in all fields.", "error"); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setStatus("Please enter a valid email address.", "error"); return; }

      if (!CONTACT_EMAIL || CONTACT_EMAIL.indexOf("@") < 0) {
        setStatus("Contact form isn't configured yet — email address is missing in the code.", "error");
        if (note && note.dataset.pending === "1") note.hidden = false;
        return;
      }

      var subject = encodeURIComponent("Portfolio contact from " + name);
      var bodyTxt = encodeURIComponent(message + "\n\n— " + name + " (" + email + ")");
      window.location.href = "mailto:" + CONTACT_EMAIL + "?subject=" + subject + "&body=" + bodyTxt;
      setStatus("Opening your email app…", "ok");
    });
  }

  /* ============================================================
     THREE.JS (Wrapped in try/catch for robustness)
     ============================================================ */
  try {
    var container = document.getElementById('webgl-container');
    if (container && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.THREE) {
      var scene = new THREE.Scene();
      var camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
      var renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
      
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      var particlesCount = 200;
      var posArray = new Float32Array(particlesCount * 3);
      for (var i = 0; i < particlesCount * 3; i += 3) {
        posArray[i] = (Math.random() - 0.5) * 10;
        posArray[i+1] = (Math.random() - 0.5) * 10;
        posArray[i+2] = (Math.random() - 0.5) * 10;
      }
      
      var geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
      
      var material = new THREE.PointsMaterial({ color: 0x090909, size: 0.02, transparent: true, opacity: 0.8 });
      var particles = new THREE.Points(geometry, material);
      scene.add(particles);

      camera.position.z = 3;

      var mouseX = 0, mouseY = 0;
      document.addEventListener('mousemove', function(e) {
        mouseX = (e.clientX / window.innerWidth - 0.5) * 0.2;
        mouseY = (e.clientY / window.innerHeight - 0.5) * 0.2;
      });

      var clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);
        var elapsedTime = clock.getElapsedTime();
        particles.rotation.y = elapsedTime * 0.05;
        particles.rotation.x = elapsedTime * 0.02;
        camera.position.x += (mouseX - camera.position.x) * 0.05;
        camera.position.y += (-mouseY - camera.position.y) * 0.05;
        camera.lookAt(scene.position);
        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', function() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    }
  } catch (err) {
    console.warn("Three.js failed to initialize. Background will be static.", err);
    var webglContainer = document.getElementById('webgl-container');
    if (webglContainer) webglContainer.style.display = 'none';
  }

  /* ============================================================
     GSAP ANIMATIONS
     ============================================================ */
  // If GSAP failed to load, bail gracefully.
  if (!window.gsap) {
    console.warn("GSAP not found. Content is visible but animations are disabled.");
    return;
  }

  try {
    gsap.registerPlugin(ScrollTrigger);

    // 1. Scroll Progress Bar
    gsap.to("#scroll-progress", {
      scaleX: 1,
      ease: "none",
      scrollTrigger: { trigger: "body", start: "top top", end: "bottom bottom", scrub: 0.3 }
    });

    // 2. Hero Entrance Timeline (Animating from hidden states)
    var heroTl = gsap.timeline({ defaults: { ease: "power3.out" } });

    // Ensure elements are initially visible before animating. We use fromTo to control both states.
    heroTl.from(".site-header", { y: -20, opacity: 0, duration: 0.8 })
          .from(".hero-meta-top", { y: 20, opacity: 0, duration: 0.6 }, "-=0.4")
          .fromTo(".collage-paper", { scaleY: 0 }, { scaleY: 1, duration: 0.8, transformOrigin: "top center" }, "-=0.2")
          .fromTo("#hero-type", 
            { clipPath: "polygon(0 0, 100% 0, 100% 0, 0 0)", opacity: 0, y: 50 },
            { clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)", opacity: 1, y: 0, duration: 1 },
            "-=0.4"
          )
          .from(".collage-portrait", { opacity: 0, y: 40, duration: 1, ease: "power4.out" }, "-=0.6")
          .from(".collage-decor--1", { opacity: 0, scale: 0.5, rotation: -45, duration: 0.5 }, "-=0.4")
          .from(".collage-decor--2", { opacity: 0, scale: 0.5, rotation: 45, duration: 0.5 }, "-=0.4")
          .from(".hero-intro-bottom", { opacity: 0, y: 30, duration: 0.8 }, "-=0.2");

    // 3. Hero Parallax
    gsap.to("#hero-type", {
      y: -100, ease: "none",
      scrollTrigger: { trigger: ".hero-collage", start: "top top", end: "bottom top", scrub: true }
    });
    gsap.to(".collage-portrait", {
      y: 50, ease: "none",
      scrollTrigger: { trigger: ".hero-collage", start: "top top", end: "bottom top", scrub: true }
    });

    // 4. Draw Torn Dividers (SVG) - Initially stroke-dasharray from CSS
    gsap.utils.toArray(".torn").forEach(function(torn) {
      gsap.fromTo(torn.querySelectorAll("path"),
        { strokeDashoffset: 2000 },
        { strokeDashoffset: 0, duration: 1.5, ease: "power2.out",
          scrollTrigger: { trigger: torn, start: "top 90%" }
        }
      );
    });

    // 5. Facts List Stagger
    gsap.from(".facts li", {
      opacity: 0, x: -20, duration: 0.6, stagger: 0.1, ease: "power3.out",
      scrollTrigger: { trigger: ".facts", start: "top 85%" }
    });

    // 6. Skills Table Reveal
    gsap.utils.toArray(".skill-row").forEach(function(row) {
      gsap.from(row, {
        opacity: 0, y: 30, duration: 0.6, ease: "power2.out",
        scrollTrigger: { trigger: row, start: "top 85%" }
      });
    });

    // 7. Projects Scroll Reveal
    gsap.utils.toArray(".project-item").forEach(function(item) {
      gsap.from(item, {
        opacity: 0, y: 40, duration: 0.8, ease: "power3.out",
        scrollTrigger: { trigger: item, start: "top 85%" }
      });
    });

    // 8. 3D Tilt Effect for Projects (gsap quickTo)
    var tiltCards = document.querySelectorAll("[data-tilt]");
    tiltCards.forEach(function(card) {
      var xTo = gsap.quickTo(card, "rotationX", { duration: 0.6, ease: "power3" });
      var yTo = gsap.quickTo(card, "rotationY", { duration: 0.6, ease: "power3" });
      
      card.addEventListener("mousemove", function(e) {
        if (window.innerWidth < 768) return; // Disable on touch/mobile
        var rect = card.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var rotX = ((y / rect.height) - 0.5) * -5;
        var rotY = ((x / rect.width) - 0.5) * 5;
        xTo(rotX);
        yTo(rotY);
      });
      
      card.addEventListener("mouseleave", function() {
        xTo(0);
        yTo(0);
      });
    });

    // 9. Magnetic Buttons
    var magneticBtns = document.querySelectorAll("[data-magnetic]");
    magneticBtns.forEach(function(btn) {
      var xTo = gsap.quickTo(btn, "x", { duration: 0.4, ease: "power3" });
      var yTo = gsap.quickTo(btn, "y", { duration: 0.4, ease: "power3" });
      
      btn.addEventListener("mousemove", function(e) {
        if (window.innerWidth < 768) return;
        var rect = btn.getBoundingClientRect();
        var x = e.clientX - rect.left - rect.width / 2;
        var y = e.clientY - rect.top - rect.height / 2;
        xTo(x * 0.3);
        yTo(y * 0.3);
      });
      
      btn.addEventListener("mouseleave", function() {
        xTo(0);
        yTo(0);
      });
    });

    // 10. Footer Parallax
    gsap.to(".footer__brand", {
      y: -30, ease: "none",
      scrollTrigger: { trigger: ".site-footer", start: "top bottom", end: "bottom top", scrub: true }
    });

  } catch (error) {
    console.error("GSAP Animation initialization failed.", error);
  }

})();
</script>
