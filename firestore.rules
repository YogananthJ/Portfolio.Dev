rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidAnalytics(data) {
      return data.keys().hasAll(['count']) &&
             data.keys().hasOnly(['count', 'lastUpdated']) &&
             data.count is number &&
             data.count >= 0 &&
             (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 64));
    }

    match /analytics/{docId} {
      allow read: if true;
      allow create: if isValidAnalytics(request.resource.data) &&
                       request.resource.data.count <= 2000;
      // Prevent count reduction or mass inflation: count must strictly increment by at most 5 per write
      allow update: if isValidAnalytics(request.resource.data) &&
                       request.resource.data.count >= resource.data.count &&
                       request.resource.data.count <= resource.data.count + 5;
      allow delete: if false;
    }
  }
}
